# רשימת המשתמשים של האפליקציה (JSON) - כל משתמש עם login נפרד, מספר טלפון משלו (משמש
# גם כמזהה שיחה בצ'אט), שלוחת ימות נפרדת לשיחות נכנסות (yemotExtension - גם המספר שמקישים
# בטונים כדי לבחור אותו כנמען) ושלוחת ימות נפרדת לשמיעת הודעות (yemotReplyExtension).
# הודעות, Push ו-login מופרדים לגמרי בין המשתמשים; כולם חולקים את אותו חשבון ימות (ראו users.js).
# הסיסמה מוצפנת (scrypt) לפני שמירה ב-DB באתחול השרת - לא נשמרת בטקסט גלוי.
USERS_JSON=[{"username":"dad","password":"secret1","phone":"0501111111","yemotExtension":"135","yemotReplyExtension":"6"},{"username":"mom","password":"secret2","phone":"0502222222","yemotExtension":"136","yemotReplyExtension":"7"}]

# תרוץ פעם אחת: node generate-vapid-keys.js ותדביק כאן את מה שמודפס
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com

# רק אם הגדרת Persistent Disk ב-Render, אחרת השאר ריק
DATA_DIR=

# פרטי החשבון שלך בימות המשיח (אותם פרטים שמשתמשים בהם ל-Login ב-API, משותפים לכל המשתמשים)
YEMOT_SYSTEM_NUMBER=0771234567
YEMOT_PASSWORD=your-yemot-password

# תמלול הקלטות (אופציונלי - אם לא מוגדר, ההקלטה נשמרת בלי טקסט מתומלל)
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
